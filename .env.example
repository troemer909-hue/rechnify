# Database (PostgreSQL)
DATABASE_URL=postgresql://user:pass@localhost:5432/rechnify

# Auth.js v5 — generate with: openssl rand -hex 32
AUTH_SECRET=

# S3-compatible storage (Cloudflare R2 or AWS S3)
S3_BUCKET=
S3_ENDPOINT=                # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto              # "auto" for R2, "eu-central-1" for AWS Frankfurt
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Claude / Anthropic API
ANTHROPIC_API_KEY=          # sk-ant-…
ANTHROPIC_MODEL=claude-sonnet-4-5

# Stripe
STRIPE_SECRET_KEY=          # sk_live_… or sk_test_…
STRIPE_WEBHOOK_SECRET=      # whsec_… (from Stripe dashboard → Webhooks)
STRIPE_MONTHLY_PRICE_ID=    # price_… for the Monatspauschale product

# Resend (transactional email)
RESEND_API_KEY=             # re_…
RESEND_FROM_EMAIL=          # Optional verified sender, e.g. Rechnify <invite@example.com>

# App (optional, used for absolute URLs in emails)
NEXT_PUBLIC_APP_URL=https://app.rechnify.de
